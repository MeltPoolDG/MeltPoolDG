{
  "$schema": "../../parameters.schema.json",
  "base": {
    "case name": "stefans_problem1_with_flow_and_heat",
    "dimension": 1,
    "global refinements": 1001,
    "do print parameters": true,
    "verbosity level": 3,
    "fe": {
      "degree": 1
    }
  },
  "profiling": {
    "verbosity": "none"
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 0.36,
    "time step size": 5e-05
  },
  "case specific": {
    "y max": 0.001,
    "y interface": 1e-06
  },
  "material": {
    "gas": {
      "thermal conductivity": 0.01,
      "specific heat capacity": 1000.0,
      "density": 1,
      "dynamic viscosity": 1e-10
    },
    "liquid": {
      "thermal conductivity": 1,
      "specific heat capacity": 1000.0,
      "density": 1,
      "dynamic viscosity": 1
    },
    "boiling temperature": 373.15,
    "latent heat of evaporation": 1000000.0,
    "molar mass": 0.01801528,
    "two phase fluid properties transition type": "consistent_with_evaporation"
  },
  "evaporation": {
    "interface temperature evaluation type": "interface_value",
    "evaporative mass flux model": "hardt_wondra",
    "hardt wondra": {
      "coefficient": 0.005
    },
    "analytical": {
      "function": "2*0.070593*sqrt(1e-5)/sqrt(max(t,1e-6))"
    },
    "formulation source term level set": "interface_velocity_local",
    "evaporative cooling": {
      "model": "regularized",
      "enable": true,
      "dirac delta function approximation": {
        "type": "heaviside_phase_weighted",
        "auto weights": true
      }
    },
    "evaporative dilation rate": {
      "model": "regularized",
      "enable": true
    },
    "recoil pressure": {
      "dirac delta function approximation": {
        "auto weights": true,
        "type": "heaviside_phase_weighted"
      },
      "interface distributed flux type": "local_value",
      "activation temperature": 0,
      "enable": false
    }
  },
  "application specific": {
    "do heat transfer": true
  },
  "adaptive meshing": {
    "do amr": false,
    "do not modify boundary cells": false,
    "upper perc to refine": 0.2,
    "lower perc to coarsen": 0.2,
    "n initial refinement cycles": 10,
    "max grid refinement level": 5,
    "every n step": 1
  },
  "heat": {
    "linear solver": {
      "rel tolerance": 1e-20,
      "preconditioner type": "AMG"
    },
    "nlsolve": {
      "field correction tolerance": 1e-07,
      "residual tolerance": 0.001
    },
    "diffuse": {
      "use volume-specific thermal capacity for phase interpolation": true
    }
  },
  "output": {
    "directory": "output_stefans_problem_1",
    "write time step size": 0.01,
    "do user defined postprocessing": true,
    "paraview": {
      "enable": true
    }
  },
  "level set": {
    "reinitialization": {
      "enable": true,
      "hyperbolic": {
        "pseudo time stepping": {
          "n initial steps": 0,
          "max n steps": 2
        }
      },
      "interface thickness parameter": {
        "type": "absolute_value",
        "val": 2e-06
      }
    },
    "advection diffusion": {
      "linear solver": {
        "preconditioner type": "ILU"
      }
    },
    "normal vector": {
      "filter parameter": 4,
      "linear solver": {
        "preconditioner type": "ILU"
      }
    },
    "nearest point": {
      "type": "nearest_point"
    }
  },
  "flow": {
    "adaflo": {
      "Navier-Stokes": {
        "physical type": "incompressible",
        "dimension": 2,
        "global refinements": 0,
        "velocity degree": 2,
        "formulation convective term momentum balance": "convective",
        "Solver": {
          "linearization scheme": "coupled implicit Newton",
          "NL max iterations": 10,
          "NL tolerance": 0.001,
          "lin max iterations": 30,
          "lin tolerance": 0.0001,
          "lin velocity preconditioner": "ilu",
          "lin its before inner solvers": 50
        }
      },
      "Time stepping": {
        "scheme": "bdf_2"
      },
      "Output options": {
        "output verbosity": 3,
        "output wall times": false
      }
    },
    "gravity": 0
  }
}
