{
  "$schema": "../../../parameters.schema.json",
  "base": {
    "case name": "recoil_pressure",
    "dimension": 2,
    "do print parameters": false,
    "global refinements": 1,
    "verbosity level": 1,
    "fe": {
      "degree": 1
    }
  },
  "time stepping": {
    "max n steps": 0,
    "end time": 0.1,
    "start time": 0.0,
    "time step size": 1e-06
  },
  "material": {
    "material template": "stainless_steel",
    "two phase fluid properties transition type": "smooth"
  },
  "case specific": {
    "domain x min": -0.0001,
    "domain x max": 0.0001,
    "domain y min": -0.0002,
    "domain y max": 0.0002,
    "cell repetitions": "1,2"
  },
  "application specific": {
    "do heat transfer": false,
    "do advect level set": false,
    "do solidification": false
  },
  "output": {
    "paraview": {
      "enable": false
    }
  },
  "evaporation": {
    "recoil pressure": {
      "enable": false
    }
  },
  "level set": {
    "reinitialization": {
      "enable": true,
      "hyperbolic": {
        "pseudo time stepping": {
          "n initial steps": 0,
          "max n steps": 0
        }
      },
      "interface thickness parameter": {
        "type": "proportional_to_cell_size",
        "val": 2
      }
    },
    "curvature": {
      "filter parameter": 4
    },
    "normal vector": {
      "filter parameter": 2
    },
    "advection diffusion": {
      "linear solver": {
        "do matrix free": true
      }
    }
  },
  "flow": {
    "adaflo": {
      "Navier-Stokes": {
        "Solver": {
          "NL max iterations": 10,
          "NL tolerance": 1e-09,
          "lin its before inner solvers": 30,
          "lin max iterations": 30,
          "lin tolerance": 1e-05,
          "lin velocity preconditioner": "ilu",
          "linearization scheme": "coupled implicit Newton"
        },
        "dimension": 2,
        "global refinements": 0,
        "physical type": "incompressible",
        "velocity degree": 2
      },
      "Output options": {
        "output verbosity": 0,
        "output wall times": false
      },
      "Time stepping": {
        "scheme": "bdf_2"
      }
    }
  }
}
