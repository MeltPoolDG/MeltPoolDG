{
  "$schema": "../../parameters.schema.json",
  "base": {
    "case name": "advection_diffusion_sine_inflow",
    "dimension": 2,
    "global refinements": 6,
    "do print parameters": false
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 0.025,
    "time step size": 0.005
  },
  "advection diffusion": {
    "time integration": {
      "type": "crank_nicolson"
    },
    "linear solver": {
      "do matrix free": true
    },
    "fe": {
      "degree": 4,
      "type": "FE_DGQ"
    }
  }
}
