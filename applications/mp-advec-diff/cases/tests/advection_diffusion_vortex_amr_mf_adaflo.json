{
  "$schema": "../../parameters.schema.json",
  "base": {
    "case name": "advection_diffusion_vortex",
    "dimension": 2,
    "global refinements": 5,
    "do print parameters": false,
    "fe": {
      "degree": 1
    }
  },
  "adaptive meshing": {
    "do amr": true,
    "upper perc to refine": 0.1,
    "lower perc to coarsen": 0.0,
    "max grid refinement level": 8
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 0.06,
    "time step size": 0.01
  },
  "output": {
    "paraview": {
      "enable": false
    }
  },
  "advection diffusion": {
    "time integration": {
      "type": "crank_nicolson"
    },
    "linear solver": {
      "do matrix free": true
    },
    "diffusivity": 0.0,
    "implementation": "adaflo"
  }
}
