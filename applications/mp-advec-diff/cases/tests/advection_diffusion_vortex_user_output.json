{
  "$schema": "../../parameters.schema.json",
  "base": {
    "case name": "advection_diffusion_vortex",
    "dimension": 2,
    "global refinements": 5,
    "do print parameters": false,
    "fe": {
      "degree": 1
    }
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 0.05,
    "time step size": 0.01
  },
  "output": {
    "do user defined postprocessing": true,
    "paraview": {
      "enable": false
    }
  },
  "advection diffusion": {
    "linear solver": {
      "preconditioner type": "ILU",
      "do matrix free": false
    },
    "diffusivity": 0.0,
    "implementation": "meltpooldg"
  }
}
