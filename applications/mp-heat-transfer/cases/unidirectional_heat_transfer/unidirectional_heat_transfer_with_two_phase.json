{
  "$schema": "../../parameters.schema.json",
  "time stepping": {
    "start time": 0.0,
    "time step size": 0.001,
    "end time": 1.0,
    "max n steps": 100
  },
  "base": {
    "case name": "unidirectional_heat_transfer",
    "dimension": 2,
    "do print parameters": false,
    "global refinements": 7,
    "fe": {
      "degree": 1
    }
  },
  "heat": {
    "linear solver": {
      "rel tolerance": 0.0001
    },
    "nlsolve": {
      "residual tolerance": 1e-06,
      "use relative tolerances": true
    },
    "radiative boundary condition": {
      "emissivity": 0.98,
      "temperature infinity": 300.0
    },
    "convective boundary condition": {
      "convection coefficient": 25,
      "temperature infinity": 300.0
    }
  },
  "case specific": {
    "do solidification": false,
    "do two phase": true,
    "velocity": 0.01
  },
  "application specific": {
    "do solidification": false
  },
  "material": {
    "gas": {
      "thermal conductivity": 27.7815,
      "specific heat capacity": 230,
      "density": 3925
    },
    "liquid": {
      "thermal conductivity": 55.563,
      "specific heat capacity": 460,
      "density": 7850
    }
  },
  "output": {
    "paraview": {
      "filename": "solution_heat_transfer_two_phase",
      "print boundary id": true,
      "enable": true
    }
  }
}
