    "end time": 4.0,
    "time step size": 1.0
  },
  "rte": {
    "rte verbosity level": 0,
    "linear solver": {
      "do matrix free": true,
      "abs tolerance": 1e-16,
      "preconditioner type": "AMG"
    }
  },
  "laser": {
    "beam direction": "0.0,-1.0"
  },
  "case specific": {
    "power": 0.1
  },
  "output": {
    "paraview": {
      "enable": false
    }
  }
}
