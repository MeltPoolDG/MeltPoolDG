{
  "$schema": "../../parameters.schema.json",
  "base": {
    "case name": "radiative_transport",
    "dimension": 2,
    "global refinements": 5,
    "do print parameters": false,
    "verbosity level": 1,
    "fe": {
      "degree": 1
    }
  },
  "profiling": {
    "verbosity": "none"
  },
  "time stepping": {
