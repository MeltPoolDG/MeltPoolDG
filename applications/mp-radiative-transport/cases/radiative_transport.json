{
  "$schema": "../parameters.schema.json",
  "base": {
    "case name": "radiative_transport",
    "dimension": 2,
    "global refinements": 7,
    "do print parameters": false,
    "verbosity level": 3,
    "fe": {
      "degree": 1
    }
  },
  "profiling": {
    "verbosity": "basic"
  },
  "time stepping": {
    "start time": 0.0,
    "end time": 20.0,
    "time step size": 1.0
  },
  "rte": {
    "rte verbosity level": 3,
    "absorptivity": {
      "absorptivity gas": 0,
      "absorptivity liquid": 10.0,
      "avoid div zero constant": 1e-10
    },
    "predictor type": "pseudo_time_stepping",
    "absorptivity type": "gradient_based",
    "pseudo time stepping": {
      "rel tolerance": 0.001,
      "time stepping": {
        "max n steps": 2
      }
    },
    "linear solver": {
      "monitor type": "reduced",
      "do matrix free": true,
      "abs tolerance": 1e-16,
      "max iterations": 10000,
      "preconditioner type": "ILU"
    }
  },
  "laser": {
    "beam direction": "0.0,-1.0"
  },
  "case specific": {
    "power": 0.1
  },
  "output": {
    "paraview": {
      "enable": true
    }
  }
}
